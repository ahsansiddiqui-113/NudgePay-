PORT=4000
CLIENT_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nudgepay
JWT_SECRET=change-me-to-a-long-random-string

# Resend
RESEND_API_KEY=re_xxx
EMAIL_FROM=NudgePay <nudges@yourdomain.com>

# Paddle Billing
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx
PADDLE_PRO_PRICE_IDS=pri_monthly_xxx,pri_yearly_xxx

# Worker
CRON_SCHEDULE=0 9 * * *
CRON_TIMEZONE=UTC
# Vercel Cron auth (any long random string)
CRON_SECRET=change-me
RUN_WORKER=true
